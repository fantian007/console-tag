{
  "private": false,
  "name": "@sprit/console-tag",
  "author": "赵永盛<1562743134@qq.com>",
  "keywords": [
    "console tags",
    "build version",
    "console debug",
    "控制台打印",
    "构建版本",
    "控制台标签"
  ],
  "version": "1.0.2",
  "license": "MIT",
  "main": "dist/index.js",
  "typings": "dist/index.d.ts",
  "module": "dist/console-tag.esm.js",
  "files": [
    "dist",
    "images",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/fantian007/console-tag"
  },
  "homepage": "https://github.com/fantian007/console-tag",
  "scripts": {
    "start": "tsdx watch",
    "build": "tsdx build",
    "lint": "tsdx lint",
    "size": "size-limit",
    "analyze": "size-limit --why",
    "preview": "cd example && yarn dev",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "peerDependencies": {
    "webpack": "^5.28.0"
  },
  "peerDependenciesMeta": {
    "@rspack/core": {
      "optional": true
    }
  },
  "prettier": {
    "printWidth": 80,
    "semi": true,
    "singleQuote": true,
    "trailingComma": "es5"
  },
  "size-limit": [
    {
      "path": "dist/console-tag.cjs.production.min.js",
      "limit": "10 KB"
    },
    {
      "path": "dist/console-tag.esm.js",
      "limit": "10 KB"
    }
  ],
  "devDependencies": {
    "@size-limit/preset-small-lib": "^8.1.0",
    "@types/html-webpack-plugin": "^3.2.9",
    "@types/react": "^18.0.26",
    "@types/react-dom": "^18.0.9",
    "@types/webpack": "^5.28.0",
    "husky": "^8.0.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "size-limit": "^8.1.0",
    "tsdx": "^0.14.1",
    "tslib": "^2.4.1",
    "typescript": "^4.9.4",
    "vitest": "^4.1.7",
    "webpack": "5.28.0"
  },
  "dependencies": {
    "@rspack/core": "^1.0.5"
  }
}
